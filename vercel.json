{
  "version": 2,
  "buildCommand": "make build",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{c_engine/**,backend/**,public/**,index.html,assignments_data.csv}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
