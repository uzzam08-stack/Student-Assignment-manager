{
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "make build",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "c_engine/**",
        "backend/**",
        "public/**",
        "index.html",
        "assignments_data.csv"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/test.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
